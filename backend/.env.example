PORT=3000
MONGODB_URI=mongodb://localhost:27017/devcanvas
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# Asgardeo OIDC Configuration
ASGARDEO_CLIENT_ID=your_asgardeo_client_id_here
ASGARDEO_CLIENT_SECRET=your_asgardeo_client_secret_here
ASGARDEO_TENANT=your_asgardeo_tenant_or_org_name
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/your_tenant
ASGARDEO_ISSUER=https://api.asgardeo.io/t/your_tenant/oauth2/token
ASGARDEO_REDIRECT_URI=http://localhost:3000/api/auth/asgardeo/callback
ASGARDEO_SCOPES=openid profile email

# Google OAuth (Legacy fallback)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
